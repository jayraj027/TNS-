   "source": [
    "### Arithmetic Operators"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "a64a1d74-5bd8-48cc-af40-67235e6a878a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "a: 21 b: 10 a+b: 31\n",
      "a: 21 b: 10 a-b: 11\n",
      "a: 21 b: 10 a*b: 210\n",
      "a: 21 b: 10 a/b: 2.1\n",
      "a: 21 b: 10 a%b: 1\n",
      "a: 2 b: 3 a**b: 8\n",
      "a: 10 b: 5 a//b: 2\n"
     ]
    }
   ],
   "source": [
    "a = 21\n",
    "b = 10\n",
    "c = 0\n",
    "\n",
    "c = a + b\n",
    "print (\"a: {} b: {} a+b: {}\".format(a,b,c))\n",
    "\n",
    "c = a - b\n",
    "print (\"a: {} b: {} a-b: {}\".format(a,b,c) )\n",
    "\n",
    "c = a * b\n",
    "print (\"a: {} b: {} a*b: {}\".format(a,b,c))\n",
    "\n",
    "c = a / b\n",
    "print (\"a: {} b: {} a/b: {}\".format(a,b,c))\n",
    "\n",
    "c = a % b\n",
    "print (\"a: {} b: {} a%b: {}\".format(a,b,c))\n",
    "\n",
    "a = 2\n",
    "b = 3\n",
    "c = a**b \n",
    "print (\"a: {} b: {} a**b: {}\".format(a,b,c))\n",
    "\n",
    "a = 10\n",
    "b = 5\n",
    "c = a//b \n",
    "print (\"a: {} b: {} a//b: {}\".format(a,b,c))"
   ]
  },
  {
   "cell_type": "markdown",
